<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Cat floating overlay -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Required for the AccessibilityService to be bindable by the system -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".YutoriKaizenApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YutoriKaizen">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:theme="@style/Theme.YutoriKaizen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One Sec — intercept overlay shown before a monitored app opens -->
        <activity
            android:name=".service.InterceptOverlayActivity"
            android:exported="false"
            android:theme="@style/Theme.YutoriKaizen.Translucent"
            android:launchMode="singleTop"
            android:showOnLockScreen="false" />

        <!-- Accessibility service: monitors foreground app changes (event-driven, no polling) -->
        <service
            android:name=".service.AppInterceptService"
            android:exported="true"
            android:label="Yutori Kaizen"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Daily 7am & 9pm reminder alarms -->
        <receiver
            android:name=".service.DailyReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.example.yutorikaizen.ACTION_MORNING_REMINDER" />
                <action android:name="com.example.yutorikaizen.ACTION_EVENING_REMINDER" />
            </intent-filter>
        </receiver>

        <!-- ══ Cat Overlay ══════════════════════════════════════════════════ -->
        <!-- Foreground service: displays the floating animated cat -->
        <service
            android:name=".service.CatOverlayService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false" />

        <!-- Transparent activity: shows the quick-shortcut popup when cat is tapped -->
        <activity
            android:name=".service.CatQuickMenuActivity"
            android:exported="false"
            android:theme="@style/Theme.YutoriKaizen.Translucent"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showOnLockScreen="false" />
    </application>

</manifest>